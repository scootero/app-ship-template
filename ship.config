# =============================================================================
# ship.config — THE ONE FILE WITH APP-SPECIFIC VALUES           [core] PHASE 1
# =============================================================================
# Every other file in this template uses placeholders like __APP_NAME__.
# Fill these in, then run:   ./Scripts/bootstrap.sh
# bootstrap swaps the placeholders everywhere and you never touch them again.
#
# This file is plain bash (KEY="value"), so scripts can `source` it directly.
# Rules: no spaces around "=", always quote values.
# =============================================================================

# --- Identity ---------------------------------------------------------------
# TODO(setup): code-safe name. Letters/numbers only, no spaces. Becomes the
# Xcode target name, scheme name, and folder of the .app. Example: FitOff
APP_NAME="MyApp"

# TODO(setup): what users see under the icon and on the store. Spaces OK.
DISPLAY_NAME="My App"

# TODO(setup): reverse-DNS prefix you own. Bundle ID becomes PREFIX.APP_NAME
# e.g. com.scottoliver  ->  com.scottoliver.FitOff
# MUST match the app record you create in App Store Connect (see SETUP.md).
BUNDLE_ID_PREFIX="com.example"

# TODO(setup): 10-char Apple team ID.
# Find it: developer.apple.com -> Account -> Membership details.
TEAM_ID="ABCDE12345"

# TODO(setup): your GitHub username (used by the website + Homebrew cask).
GITHUB_USER="your-github-user"

# --- Platforms --------------------------------------------------------------
# Which apps this repo builds. bootstrap.sh deletes the folders + targets you
# turn off, so decide before running it (you can re-add later by hand).
#   "ios"      iPhone/iPad only
#   "mac"      Mac only
#   "ios,mac"  both, sharing code in Shared/
PLATFORMS="ios"

# Minimum OS versions. Lower = more users, fewer new APIs.
IOS_MIN="17.0"
MACOS_MIN="14.0"

# --- Store / marketing ------------------------------------------------------
# Languages you ship store listings + screenshots in. Start with one.
# Each needs a store/metadata/<locale>.md file. App Store locale codes:
# en-US de-DE es-ES fr-FR it ja ko pt-BR zh-Hans ...
LOCALES="en-US"

# Screens the screenshot script visits, in order. Each name must be a route
# your app understands (see Shared/Sources/LaunchOptions.swift -> AppRoute).
# TODO(phase-4): replace with your real screens, e.g. "home battle leaderboard"
SCREENSHOT_ROUTES="home detail settings"
